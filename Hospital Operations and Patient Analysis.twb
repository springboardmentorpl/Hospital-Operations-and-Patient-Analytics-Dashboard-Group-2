      <column datatype='string' name='[Admission Type]' role='dimension' type='nominal' />
      <column datatype='integer' name='[Admission Year]' role='dimension' type='quantitative' />
      <column caption='Admissions Rate % Derived' datatype='real' name='[Admissions_Rate_%_Derived]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Bed Number]' role='dimension' type='ordinal' />
      <column caption='Bed Occupancy Rate %' datatype='real' name='[Bed_Occupancy_Rate_%]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Beds Available]' role='measure' type='quantitative' />
      <column caption='Beds Occupied Count' datatype='integer' name='[Beds_Occupied_Count]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Billing Amount]' role='measure' type='quantitative' />
      <column caption='staff utilization rate' datatype='real' name='[Calculation_0288114001788929]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Staff_Utilization_%_Derived]) / 100' />
      </column>
      <column caption='Patients Transferred ' datatype='integer' name='[Calculation_0464310318903296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Transferred] = &quot;Yes&quot;&#13;&#10;    THEN [Patient ID]&#13;&#10;    END&#13;&#10;)' />
      </column>
      <column caption='Transferred Rate' datatype='real' name='[Calculation_0464310319865857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Transferred] = &quot;Yes&quot;&#13;&#10;    THEN [Patient ID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Patient ID])' />
      </column>
      <column caption='AVG Daily Admissions' datatype='real' name='[Calculation_0464310320152578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Patient ID])&#13;&#10;/&#13;&#10;COUNTD([Admission Date])' />
      </column>
      <column caption='AVG Daily Discharges' datatype='real' name='[Calculation_0464310320418819]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Patient ID])&#13;&#10;/&#13;&#10;COUNTD([Discharge Date])' />
      </column>
      <column caption='Resouce utilization score' datatype='real' name='[Calculation_0464310380044293]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    [Calculation_1710606399725570] * 0.40&#13;&#10;    +&#13;&#10;    [Calculation_1710606401024003] * 0.40&#13;&#10;    +&#13;&#10;    (1 - [Calculation_1710606399217665]) * 0.20&#13;&#10;)' />
      </column>
      <column caption='Available beds' datatype='integer' name='[Calculation_0464310381080582]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Hospital ID], [Department] : MAX([Beds Available]) }' />
      </column>
      <column caption='Equipment Utilization Rate' datatype='real' name='[Calculation_0464310382157831]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Equipment Status] = &quot;In Use&quot;&#13;&#10;    THEN [Equipment ID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Equipment ID])' />
      </column>
      <column caption='Available Beds' datatype='integer' name='[Calculation_1390924409520128]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Hospital ID], [Department] :&#13;&#10;MAX([Beds Available])&#13;&#10;}' />
      </column>
      <column caption='box' datatype='string' name='[Calculation_1710606371856384]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;&quot;' />
      </column>
      <column caption='Readmission Rate' datatype='real' name='[Calculation_1710606399217665]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Readmission] = &quot;Yes&quot;&#13;&#10;    THEN [Patient ID]&#13;&#10;    END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNTD([Patient ID])' />
      </column>
      <column caption='Bed Utilization Rate' datatype='real' name='[Calculation_1710606399725570]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Bed_Occupancy_Rate_%])' />
      </column>
      <column caption='Staff Utilization Rate' datatype='real' name='[Calculation_1710606401024003]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Staff_Utilization_%_Derived]) / 100' />
      </column>
      <column caption='Efficiency Score' datatype='real' name='[Calculation_1710606401277956]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    [Calculation_1710606399725570] * 0.40&#13;&#10;    +&#13;&#10;    [Calculation_1710606401024003] * 0.40&#13;&#10;    +&#13;&#10;    (1 - [Calculation_1710606399217665]) * 0.20&#13;&#10;)' />
      </column>

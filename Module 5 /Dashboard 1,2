   <connection class="federated">
    <named-connections>
     <named-connection caption="Hospital_cleaned.csv" name="textscan.hospital">
      <connection class="textscan" directory="." filename="Hospital_cleaned.csv" workgroup-auth-mode="as-is" />
     </named-connection>
    </named-connections>
    <relation connection="textscan.hospital" name="Hospital_cleaned.csv" table="[Hospita_cleaned#csv]" type="table">
     <columns character-set="UTF-8" header="yes" locale="en_US" separator=",">
      <column datatype="integer" name="Patient_ID" ordinal="0" />
      <column datatype="integer" name="Age" ordinal="1" />
      <column datatype="string" name="Gender" ordinal="2" />
      <column datatype="string" name="Condition" ordinal="3" />
      <column datatype="string" name="Medication" ordinal="4" />
      <column datatype="date" name="Admission_Date" ordinal="5" />
      <column datatype="date" name="Discharge_Date" ordinal="6" />
      <column datatype="string" name="Patient_State" ordinal="7" />
      <column datatype="datetime" name="Year_of_Admission" ordinal="8" />
      <column datatype="integer" name="Length_of_Stay" ordinal="9" />
      <column datatype="string" name="Readmission" ordinal="10" />
      <column datatype="string" name="Outcome" ordinal="11" />
      <column datatype="integer" name="Satisfaction" ordinal="12" />
      <column datatype="string" name="Insurance_Claimed" ordinal="13" />
      <column datatype="integer" name="Total_Cost" ordinal="14" />
     </columns>
    </relation>
   </connection>
   <column datatype="integer" name="[Patient_ID]" role="measure" type="quantitative" />
   <column datatype="integer" name="[Age]" role="measure" type="quantitative" />
   <column datatype="string" name="[Gender]" role="dimension" type="nominal" />
   <column datatype="string" name="[Condition]" role="dimension" type="nominal" />
   <column datatype="string" name="[Medication]" role="dimension" type="nominal" />
   <column datatype="date" name="[Admission_Date]" role="dimension" type="ordinal" />
   <column datatype="date" name="[Discharge_Date]" role="dimension" type="ordinal" />
   <column datatype="string" name="[Patient_State]" role="dimension" type="nominal" />
   <column datatype="datetime" name="[Year_of_Admission]" role="dimension" type="ordinal" />
   <column datatype="integer" name="[Length_of_Stay]" role="measure" type="quantitative" />
   <column datatype="string" name="[Readmission]" role="dimension" type="nominal" />
   <column datatype="string" name="[Outcome]" role="dimension" type="nominal" />
   <column datatype="integer" name="[Satisfaction]" role="measure" type="quantitative" />
   <column datatype="string" name="[Insurance_Claimed]" role="dimension" type="nominal" />
   <column datatype="integer" name="[Total_Cost]" role="measure" type="quantitative" />
   <column caption="Age Group" datatype="string" name="[Calculation_Age_Group]" role="dimension" type="nominal">
    <calculation class="tableau" formula="IF [Age] &lt;= 18 THEN &quot;0-18&quot; ELSEIF [Age] &lt;= 30 THEN &quot;19-30&quot; ELSEIF [Age] &lt;= 40 THEN &quot;31-40&quot; ELSEIF [Age] &lt;= 50 THEN &quot;41-50&quot; ELSEIF [Age] &lt;= 60 THEN &quot;51-60&quot; ELSE &quot;61+&quot; END" />
   </column>
   <column caption="Admission Month" datatype="string" name="[Calculation_Admission_Month]" role="dimension" type="nominal">
    <calculation class="tableau" formula="DATENAME('month',[Admission_Date])" />
   </column>
   <column caption="Patient Status" datatype="string" name="[Calculation_Patient_Status]" role="dimension" type="nominal">
    <calculation class="tableau" formula="IF [Readmission] = &quot;Yes&quot; THEN &quot;Readmitted&quot; ELSE [Outcome] END" />
   </column>
   <column caption="Readmission Rate" datatype="real" name="[Calculation_Readmission_Rate]" role="measure" type="quantitative">
    <calculation class="tableau" formula="SUM(IF [Readmission] = &quot;Yes&quot; THEN 1 ELSE 0 END) / COUNT([Patient_ID])" />
   </column>

    <worksheet name='DEPARTMENT COMPARISON - ADMISSIONS, LOS &amp; EFFICIENCY'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hospital_cleaned' name='federated.0j5za1d1hzmy9v1da4duu003ksrn' />
          </datasources>
          <datasource-dependencies datasource='federated.0j5za1d1hzmy9v1da4duu003ksrn'>
            <column caption='Department Efficiency' datatype='real' name='[Calculation_1132814192898062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 -&#13;&#10;(&#13;&#10;    { FIXED [department_name] :&#13;&#10;        COUNTD(&#13;&#10;            IF { FIXED [patient_id] : COUNTD([admission_id]) } &gt; 1&#13;&#10;            THEN [patient_id]&#13;&#10;            END&#13;&#10;        )&#13;&#10;    }&#13;&#10;    /&#13;&#10;    { FIXED [department_name] : COUNTD([patient_id]) }&#13;&#10;) * 100' />
            </column>
            <column caption='Admission Id' datatype='integer' name='[admission_id]' role='dimension' type='ordinal' />
            <column-instance column='[length_of_stay]' derivation='Avg' name='[avg:length_of_stay:qk]' pivot='key' type='quantitative' />
            <column-instance column='[admission_id]' derivation='CountD' name='[ctd:admission_id:qk]' pivot='key' type='quantitative' />
            <column caption='Department Name' datatype='string' name='[department_name]' role='dimension' type='nominal' />
            <column caption='Length Of Stay' datatype='integer' name='[length_of_stay]' role='measure' type='quantitative' />
            <column-instance column='[department_name]' derivation='None' name='[none:department_name:nk]' pivot='key' type='nominal' />
            <column caption='Patient Id' datatype='integer' name='[patient_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1132814192898062]' derivation='Sum' name='[sum:Calculation_1132814192898062:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style>
          <style-rule element='label'>
            <format attr='color' field='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[avg:length_of_stay:qk]' value='#ffffff' />
            <format attr='color' field='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[ctd:admission_id:qk]' value='#ffffff' />
          </style-rule>
          <style-rule element='table'>
            <format attr='background-color' value='#0d3554' />
          </style-rule>
        </style>
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Circle' />
            <encodings>
              <color column='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[none:department_name:nk]' />
              <size column='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[sum:Calculation_1132814192898062:qk]' />
              <lod column='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[none:department_name:nk]' />
            </encodings>
          </pane>
        </panes>
        <rows>[federated.0j5za1d1hzmy9v1da4duu003ksrn].[avg:length_of_stay:qk]</rows>
        <cols>[federated.0j5za1d1hzmy9v1da4duu003ksrn].[ctd:admission_id:qk]</cols>
      </table>

    <worksheet name='PATIENT AGE DISTRIBUTION '>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontsize='10'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hospital_cleaned' name='federated.0j5za1d1hzmy9v1da4duu003ksrn' />
          </datasources>
          <datasource-dependencies datasource='federated.0j5za1d1hzmy9v1da4duu003ksrn'>
            <column caption='Patient Age' datatype='integer' name='[Calculation_1633641376673799]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;year&apos;, [date_of_birth], TODAY())' />
            </column>
            <column aggregation='None' caption='Patient Age (bin)' datatype='integer' name='[Patient Age (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='1' formula='[Calculation_1633641376673799]' peg='0' size='10' />
            </column>
            <column caption='Admission Date' datatype='date' name='[admission_date]' role='dimension' type='ordinal' />
            <column-instance column='[patient_id]' derivation='CountD' name='[ctd:patient_id:qk]' pivot='key' type='quantitative' />
            <column caption='Date Of Birth' datatype='date' name='[date_of_birth]' role='dimension' type='ordinal' />
            <column-instance column='[Patient Age (bin)]' derivation='None' name='[none:Patient Age (bin):ok]' pivot='key' type='ordinal' />
            <column-instance column='[admission_date]' derivation='None' name='[none:admission_date:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ward_type]' derivation='None' name='[none:ward_type:nk]' pivot='key' type='nominal' />
            <column caption='Patient Id' datatype='integer' name='[patient_id]' role='dimension' type='ordinal' />
            <column caption='Ward Type' datatype='string' name='[ward_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='quantitative' column='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[none:admission_date:qk]' included-values='in-range'>
            <min>#2020-01-01#</min>
            <max>#2025-12-31#</max>
          </filter>
          <filter class='categorical' column='[federated.0j5za1d1hzmy9v1da4duu003ksrn].[none:ward_type:nk]'>
            <groupfilter function='level-members' level='[none:ward_type:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />

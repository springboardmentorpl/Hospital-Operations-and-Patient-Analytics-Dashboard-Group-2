          <datasource-dependencies datasource='federated.0j5za1d1hzmy9v1da4duu003ksrn'>
            <column caption='Department Efficiency' datatype='real' name='[Calculation_1132814192898062]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='100 -&#13;&#10;(&#13;&#10;    { FIXED [department_name] :&#13;&#10;        COUNTD(&#13;&#10;            IF { FIXED [patient_id] : COUNTD([admission_id]) } &gt; 1&#13;&#10;            THEN [patient_id]&#13;&#10;            END&#13;&#10;        )&#13;&#10;    }&#13;&#10;    /&#13;&#10;    { FIXED [department_name] : COUNTD([patient_id]) }&#13;&#10;) * 100' />

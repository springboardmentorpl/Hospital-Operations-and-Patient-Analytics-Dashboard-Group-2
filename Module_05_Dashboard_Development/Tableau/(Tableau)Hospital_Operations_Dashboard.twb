    <worksheet name='Sheet 50'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontcolor='#000000' fontname='Tableau Book'>Available Beds vs Occupied Beds</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Cleaned_Data (hospital_final_dataset)' name='federated.1t2qtx00m8xypx1g3tsf31gjfqlz' />
          </datasources>
          <datasource-dependencies datasource='federated.1t2qtx00m8xypx1g3tsf31gjfqlz'>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column caption='Beds Occupied' datatype='integer' name='[Beds_Occupied]' role='measure' type='quantitative' />
            <column caption='Calculation1' datatype='real' name='[Calculation_1453322074992642]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ICU_Beds_Occupied]) / SUM([ICU_Beds_Available]) * 100' />
            </column>
            <column caption='Calculation2' datatype='real' name='[Calculation_1453322075471875]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ICU_Beds_Occupied]) / SUM([Total_Beds_Available]) * 100' />
            </column>
            <column caption='Calculation3' datatype='integer' name='[Calculation_1453322080079876]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Ventilator_Required] = &quot;Yes&quot; THEN 1 END' />
            </column>
            <column caption='Resource Utilization %' datatype='real' name='[Calculation_1453322080419845]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ICU_Beds_Occupied]) /&#13;&#10;SUM([ICU_Beds_Available]) * 100' />
            </column>
            <column caption='ICU Beds Available' datatype='integer' name='[ICU_Beds_Available]' role='measure' type='quantitative' />
            <column caption='ICU Beds Occupied' datatype='integer' name='[ICU_Beds_Occupied]' role='measure' type='quantitative' />
            <column caption='Length of Stay' datatype='integer' name='[Length_of_Stay]' role='measure' type='quantitative' />
            <column caption='Occupancy Rate' datatype='real' name='[Occupancy_Rate]' role='measure' type='quantitative' />
            <column caption='Oxygen Units Used' datatype='integer' name='[Oxygen_Units_Used]' role='measure' type='quantitative' />
            <column caption='Total Beds Available' datatype='integer' name='[Total_Beds_Available]' role='measure' type='quantitative' />
            <column caption='Ventilator Required' datatype='string' name='[Ventilator_Required]' role='dimension' type='nominal' />
            <column caption='Cleaned_Data' datatype='table' name='[__tableau_internal_object_id__].[Cleaned!Data_8EEF45227B584F35A74FF1292DF0673A]' role='measure' type='quantitative' />
            <column-instance column='[__tableau_internal_object_id__].[Cleaned!Data_8EEF45227B584F35A74FF1292DF0673A]' derivation='Count' name='[__tableau_internal_object_id__].[cnt:Cleaned!Data_8EEF45227B584F35A74FF1292DF0673A:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Age]' derivation='Sum' name='[sum:Age:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Beds_Occupied]' derivation='Sum' name='[sum:Beds_Occupied:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1453322080079876]' derivation='Sum' name='[sum:Calculation_1453322080079876:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ICU_Beds_Available]' derivation='Sum' name='[sum:ICU_Beds_Available:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ICU_Beds_Occupied]' derivation='Sum' name='[sum:ICU_Beds_Occupied:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Length_of_Stay]' derivation='Sum' name='[sum:Length_of_Stay:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Occupancy_Rate]' derivation='Sum' name='[sum:Occupancy_Rate:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Oxygen_Units_Used]' derivation='Sum' name='[sum:Oxygen_Units_Used:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Total_Beds_Available]' derivation='Sum' name='[sum:Total_Beds_Available:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1453322074992642]' derivation='User' name='[usr:Calculation_1453322074992642:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1453322075471875]' derivation='User' name='[usr:Calculation_1453322075471875:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1453322080419845]' derivation='User' name='[usr:Calculation_1453322080419845:qk]' pivot='key' type='quantitative' />

      <aliases enabled='yes' />
      <column caption='Admission Type' datatype='string' name='[Admission_Type]' role='dimension' type='nominal' />
      <column caption='Age Group' datatype='string' name='[Age_Group]' role='dimension' type='nominal' />
      <column caption='Bed Required' datatype='string' name='[Bed_Required]' role='dimension' type='nominal' />
      <column caption='Beds Occupied' datatype='integer' name='[Beds_Occupied]' role='measure' type='quantitative' />
      <column caption='Calculation1' datatype='real' name='[Calculation_1453322074992642]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ICU_Beds_Occupied]) / SUM([ICU_Beds_Available]) * 100' />
      </column>
      <column caption='Calculation2' datatype='real' name='[Calculation_1453322075471875]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ICU_Beds_Occupied]) / SUM([Total_Beds_Available]) * 100' />
      </column>
      <column caption='Calculation3' datatype='integer' name='[Calculation_1453322080079876]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Ventilator_Required] = &quot;Yes&quot; THEN 1 END' />
      </column>
      <column caption='Resource Utilization %' datatype='real' name='[Calculation_1453322080419845]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([ICU_Beds_Occupied]) /&#13;&#10;SUM([ICU_Beds_Available]) * 100' />
      </column>
      <column caption='Day of Week' datatype='string' name='[Day_of_Week]' role='dimension' type='nominal' />
      <column caption='ICU Beds Available' datatype='integer' name='[ICU_Beds_Available]' role='measure' type='quantitative' />

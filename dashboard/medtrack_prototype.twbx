      <column caption='IP Admissions' datatype='integer' name='[Calculation_0275743735095296]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Case type] = &quot;IP&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='IP Admission Rate' datatype='real' name='[Calculation_0275743735377921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_0275743735095296]) / COUNT([Case_No])' />
      </column>
      <column caption='Average IP LOS' datatype='real' name='[Calculation_0275743823876099]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Case type] = &quot;IP&quot; THEN [LOS] END' />

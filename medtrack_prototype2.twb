        </calculation>
      </column>
      <column datatype='integer' name='[Calculation3]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([Calculation_0254028448116739]) - LOOKUP(ZN([Calculation_0254028448116739]), -1)'>
          <table-calc ordering-type='Columns' />
        </calculation>
      </column>
      <column caption='Age (String)' datatype='string' datatype-customized='true' default-role='measure' default-type='quantitative' name='[Calculation_0131983992938496]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(2025-[Birth_Year])' />
      </column>
      <column caption='Day-Patient Cases' datatype='integer' name='[Calculation_0254028440633344]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is_Admission]=1 AND  [Case_Type] = &quot;DC&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Total Number of Departments' datatype='integer' name='[Calculation_0254028442628097]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Specialty])' />
      </column>
      <column caption='In-Patient Cases' datatype='integer' name='[Calculation_0254028444274690]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [Is_Admission]=1 AND [Case_Type] = &quot;IP&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Total Doctors Available' datatype='integer' name='[Calculation_0254028448116739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Doctor_Status] = &quot;Active&quot; THEN [DoctorLicense] END)' />
      </column>
      <column caption='Readmission Rate' datatype='real' name='[Calculation_1054197971288064]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Readmitted] = &quot;Yes&quot; THEN 1 ELSE 0 END&#13;&#10;)&#13;&#10;/&#13;&#10;COUNT([Case_No])' />
      </column>
      <column caption='Readmission Count' datatype='integer' name='[Calculation_1054197972865025]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Readmitted] = &quot;Yes&quot; THEN 1 ELSE 0 END' />
      </column>
      <column caption='Occupancy Rate' datatype='real' name='[Calculation_1054197985423364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([LOS]) / (150 * 365)' />
      </column>
      <column caption='Bed Utilization rate' datatype='real' name='[Calculation_1054197985656837]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(if [Is_Admission]=1 then [LOS] END) / (150*365)' />
      </column>
      <column caption='Department Efficiency' datatype='real' name='[Calculation_1054197986856966]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([CMI_Value]) / AVG([LOS])' />
      </column>
      <column caption='Staff Allocation' datatype='integer' name='[Calculation_1054197988085767]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [Doctor_Status] = &apos;Active&apos; THEN [DoctorLicense] END)' />
      </column>
      <column caption='Resource Availability' datatype='integer' name='[Calculation_1054197991682057]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='150 - sum([Is_Admission])' />
      </column>

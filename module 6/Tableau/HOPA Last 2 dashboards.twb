      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0r3ux6c1yfl3fd1fhzz6a1p4rtw5]&quot;' value='Total Admissions' />
          <alias key='&quot;[federated.0r3ux6c1yfl3fd1fhzz6a1p4rtw5].[sum:Billing Amount:qk]&quot;' value='Total Revnue' />
        </aliases>
      </column>
      <column datatype='string' name='[Admission Month]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;December&quot;' value='Dec' />
          <alias key='&quot;February&quot;' value='Feb' />
          <alias key='&quot;January&quot;' value='Jan' />
          <alias key='&quot;November&quot;' value='Nov' />
          <alias key='&quot;October&quot;' value='Oct' />
          <alias key='&quot;September&quot;' value='Sept' />
